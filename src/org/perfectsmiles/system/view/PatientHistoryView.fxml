<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="1000.0" stylesheets="@../resources/styles/PatientHistoryStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.perfectsmiles.system.controller.PatientHistoryController">

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <Label fx:id="lblTituloApp" text="Sonrisas Perfectas - Panel de Administracion">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsuarioActual" text="Usuario: -" />
            <Label fx:id="lblRolActual" text="Rol: -" />
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebarMenu" prefWidth="190.0" spacing="4.0" BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="20.0" />
            </padding>

            <Button fx:id="btnTarifario" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToTariff" text="Tarifario" />
            <Button fx:id="btnPresupuestos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToBudgets" text="Presupuestos" />
            <Button fx:id="btnPacientes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToPatients" text="Pacientes" />
            <Button fx:id="btnUsuarios" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToUsers" text="Usuarios" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator />
            <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" text="Cerrar Sesion" />
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentArea" spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label fx:id="lblTituloModulo" text="Historial de Presupuestos">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label fx:id="lblPacienteInfo" text="Paciente: -" />

            <TableView fx:id="tblHistorial" VBox.vgrow="ALWAYS" prefHeight="280.0">
                <columns>
                    <TableColumn fx:id="colIdPresupuesto" prefWidth="90.0" text="ID" />
                    <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
                    <TableColumn fx:id="colDescripcion" prefWidth="220.0" text="Descripcion" />
                    <TableColumn fx:id="colSubtotal" prefWidth="90.0" text="Subtotal" />
                    <TableColumn fx:id="colIva" prefWidth="80.0" text="IVA" />
                    <TableColumn fx:id="colTotal" prefWidth="90.0" text="Total" />
                    <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
                </columns>
            </TableView>

            <Label text="Detalle del Presupuesto Seleccionado">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>

            <TableView fx:id="tblDetalle" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colTratamiento" prefWidth="300.0" text="Tratamiento" />
                    <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
                    <TableColumn fx:id="colPrecioUnitario" prefWidth="130.0" text="Precio Unitario" />
                    <TableColumn fx:id="colSubtotalLinea" prefWidth="130.0" text="Subtotal" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#handleBack" text="Volver a Pacientes" />
            </HBox>

            <Label fx:id="lblMensajeEstado" textFill="#a32d2d" />
        </VBox>
    </center>

</BorderPane>