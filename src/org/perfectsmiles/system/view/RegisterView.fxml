<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!--
    RegisterView - Sonrisas Perfectas (version movil 440x800)
    Controlador: org.perfectsmiles.system.controller.RegisterController

    Cambios respecto a la version anterior que me compartiste:
    - Pane pasa de 790x700 (dos columnas) a 440x800 (una sola columna,
      formato movil), como pediste.
    - Fondo: se reutiliza el mismo asset "fondo.jpg" que ya usaba el
      proyecto (el de la primera imagen que me mandaste), estirado a
      440x800 con preserveRatio=false.
    - Estructura del encabezado: logo + nombre de marca arriba, y debajo
      una ilustracion decorativa de diente + implante (como en tu segunda
      imagen de referencia). OJO: no tengo el archivo real de esa
      ilustracion, asi que apunte el ImageView a
      "@../resources/image/diente_implante.png" -> cambia ese nombre por
      el archivo real que tengas en tu carpeta de recursos (o me lo subes
      y lo ajusto).
    - Como el encabezado + los 7 campos + boton no entran comodos en 800px
      de alto, metí todo el contenido dentro de un ScrollPane transparente
      (clase "transparent-scroll" en el CSS) para que nada se corte, en
      vez de forzar tamaños que vuelvan a solapar los campos como en tu
      captura.
    - fx:id de todos los campos se dejaron IGUALES a los del archivo
      anterior para que el RegisterController no necesite cambios.
-->

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="440.0" stylesheets="@../resources/styles/RegisterStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.perfectsmiles.system.controller.RegisterController">
   <children>

      <!-- Fondo: mismo estilo/asset que la primera imagen, cubriendo todo el Pane -->
      <ImageView fitHeight="800.0" fitWidth="440.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../resources/image/fondo2.jpg" />
         </image>
      </ImageView>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="800.0" prefWidth="440.0" styleClass="transparent-scroll">
         <content>
            <VBox alignment="TOP_CENTER" prefWidth="440.0" spacing="0.0">
               <children>

                  <!-- Encabezado: logo + nombre de marca (parte superior de la 2da imagen) -->
                  <VBox alignment="CENTER" spacing="6.0">
                     <padding>
                        <Insets top="28.0" />
                     </padding>
                     <children>
                        <ImageView fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resources/image/logo1.png" />
                           </image>
                        </ImageView>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="brand-text" text="SONRISAS PERFECTAS" />
                     </children>
                  </VBox>

                  <!-- Tarjeta de vidrio con el formulario, ancho unico centrado -->
                  <VBox alignment="CENTER" prefWidth="380.0" spacing="6.0" styleClass="glass-card">
                     <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="18.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="30.0" top="14.0" />
                     </VBox.margin>
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-text" text="CREA TU CUENTA" />
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle-text" text="Completa tus datos para registrarte">
                           <VBox.margin>
                              <Insets bottom="8.0" />
                           </VBox.margin>
                        </Text>

                        <!-- Mapea a usuario.full_name -->
                        <Label styleClass="field-label" text="Nombre Completo" />
                        <TextField fx:id="txtNombreCompleto" prefWidth="336.0" promptText="Nombre y apellido" styleClass="text-input" />

                        <!-- Mapea a usuario.username -->
                        <Label styleClass="field-label" text="Usuario" />
                        <TextField fx:id="txtUsuario" prefWidth="336.0" promptText="Nombre de usuario" styleClass="text-input" />

                        <!-- Mapea a usuario.email -->
                        <Label styleClass="field-label" text="Correo Electronico" />
                        <TextField fx:id="txtCorreo" prefWidth="336.0" promptText="correo@dominio.com" styleClass="text-input" />

                        <!-- Mapea a usuario.phone -->
                        <Label styleClass="field-label" text="Telefono" />
                        <TextField fx:id="txtTelefono" prefWidth="336.0" promptText="8 dígitos" styleClass="text-input" />

                        <!-- Mapea a usuario.id_role, catalogo poblado desde sp_read_role.
                             Solo debe verse si quien esta logueado tiene permiso de crear
                             usuarios (Owner); no lo elige la propia persona registrada. -->
                        <Label styleClass="field-label" text="Rol" />
                        <ComboBox fx:id="cmbRol" prefWidth="336.0" promptText="Selecciona un rol" styleClass="text-input" />

                        <!-- Mapea a usuario.password_hash (se hashea antes de guardar) -->
                        <Label styleClass="field-label" text="Crea tu contraseña" />
                        <PasswordField fx:id="pwdPassword" prefWidth="336.0" styleClass="text-input" />

                        <!-- Solo validacion de UI, no se persiste -->
                        <Label styleClass="field-label" text="Confirma tu contraseña" />
                        <PasswordField fx:id="pwdConfirmarPassword" prefWidth="336.0" styleClass="text-input" />

                        <!-- Mensaje de error / validacion (usuario duplicado, contraseñas no coinciden, etc.) -->
                        <Label fx:id="lblMensajeError" styleClass="error-label" text="" wrapText="true">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Label>

                        <Button fx:id="btnCrearCuenta" mnemonicParsing="false" styleClass="primary-button" text="CREAR CUENTA">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>

                        <VBox alignment="CENTER" spacing="2.0">
                           <VBox.margin>
                              <Insets top="8.0" />
                           </VBox.margin>
                           <children>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle-text" text="Ya tienes cuenta?" />
                              <Hyperlink fx:id="linkIrLogin" styleClass="link-secondary" text="Inicia Sesion" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>

   </children>
</Pane>
